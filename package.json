{
  "name": "disaster-relief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "next build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --test --test-isolation=none tests/unit.test.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "mysql2": "^3.15.0",
    "mongodb": "^6.20.0",
    "ws": "^8.18.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  }
}
